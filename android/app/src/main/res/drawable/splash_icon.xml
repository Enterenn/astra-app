<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ clips splash icons to a circle (~66% of the icon canvas).
  Inset shrinks the wordmark so the full logo stays inside that safe zone.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@mipmap/launch_image"
    android:insetLeft="16%"
    android:insetTop="16%"
    android:insetRight="16%"
    android:insetBottom="16%" />
